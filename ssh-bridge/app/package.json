{
  "name": "meow-ssh-bridge-app",
  "version": "1.0.0",
  "private": true,
  "description": "Meow SSH Bridge 打包工程：把 Node 版桥接编译成单文件 bridge.exe，再嵌入 C# 托盘程序",
  "scripts": {
    "bundle": "esbuild sea-entry.js --bundle --platform=node --target=node24 --format=cjs --outfile=build/bundle.cjs --external:cpu-features --external:bufferutil --external:utf-8-validate --external:*.node",
    "sea": "node --experimental-sea-config sea-config.json",
    "inject": "postject build/bridge.exe NODE_SEA_BLOB build/sea-prep.blob --sentinel-fuse NODE_SEA_FUSE_fce680ab2cc467b6e072b8b5df1996b2",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File build.ps1"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "postject": "1.0.0-alpha.6"
  }
}
